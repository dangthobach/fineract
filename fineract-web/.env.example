# Environment template - copy to .env.local and configure

# Fineract Backend API Configuration
FINERACT_API_URL=https://localhost:8443/fineract-provider/api/v1
FINERACT_BASE_URL=https://localhost:8443/fineract-provider

# Next.js Authentication
NEXTAUTH_SECRET=your-secret-key-change-this-in-production
NEXTAUTH_URL=http://localhost:3000

# Fineract Authentication
FINERACT_USERNAME=mifos
FINERACT_PASSWORD=password
FINERACT_TENANT=default

# Development Environment
NODE_ENV=development
